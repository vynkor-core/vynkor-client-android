<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:paddingTop="4dp"
    android:paddingBottom="4dp">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/bubble"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="start"
        android:background="@drawable/bubble_assistant"
        android:maxWidth="304dp"
        android:padding="12dp">

        <TextView
            android:id="@+id/messageText"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:maxWidth="280dp"
            android:textAppearance="?attr/textAppearanceBodyLarge"
            android:textColor="@color/on_surface"
            app:layout_constrainedWidth="true"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent" />

        <!-- Assistant-only action footer: copy + more on the left, the speaker
             pinned to the right edge of the bubble. Hidden for user/error. -->
        <LinearLayout
            android:id="@+id/footerRow"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:gravity="center_vertical"
            android:minWidth="96dp"
            android:orientation="horizontal"
            android:visibility="gone"
            app:layout_constraintEnd_toEndOf="@id/messageText"
            app:layout_constraintStart_toStartOf="@id/messageText"
            app:layout_constraintTop_toBottomOf="@id/messageText">

            <ImageButton
                android:id="@+id/copyAction"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:contentDescription="@string/copy_message"
                android:padding="13dp"
                android:scaleType="fitCenter"
                android:src="@drawable/ic_copy"
                android:tint="@color/on_surface_variant"
                android:visibility="gone" />

            <ImageButton
                android:id="@+id/moreAction"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:contentDescription="@string/message_fork"
                android:padding="13dp"
                android:scaleType="fitCenter"
                android:src="@drawable/ic_more_vert"
                android:tint="@color/on_surface_variant"
                android:visibility="gone" />

            <Space
                android:layout_width="0dp"
                android:layout_height="1dp"
                android:layout_weight="1" />

            <ImageButton
                android:id="@+id/speakAction"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:contentDescription="@string/speak_message"
                android:padding="13dp"
                android:scaleType="fitCenter"
                android:src="@drawable/ic_volume"
                android:tint="@color/on_surface_variant"
                android:visibility="gone" />
        </LinearLayout>
    </androidx.constraintlayout.widget.ConstraintLayout>
</FrameLayout>